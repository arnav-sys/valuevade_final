      {
        "name": "Instructions",
        "cells": {
          "A1": {
            "value": "CEO Compensation Scorecard - Instructions",
            "readOnly": true,
            "bold": true
          },
          "A2": {
            "value": "Task 1: Apply Formulas",
            "readOnly": true,
            "bold": true
          },
          "A3": {
            "value": "1. CEO Comp % of PAT (Column D): =(B/C)*100",
            "readOnly": true
          },
          "A4": {
            "value": "2. Fixed % (Column I): =(E/B)*100",
            "readOnly": true
          },
          "A5": {
            "value": "3. CEO Pay Ratio (Column P): =(B*100)/O",
            "readOnly": true
          },
          "A6": {
            "value": "4. 5yr Comp CAGR % (Column S): =((B/Q)^(1/4)-1)*100",
            "readOnly": true
          },
          "A7": {
            "value": "5. 5yr PAT CAGR % (Column T): =((C/R)^(1/4)-1)*100",
            "readOnly": true
          },
          "A8": {
            "value": "Task 2: Manual Scores",
            "readOnly": true,
            "bold": true
          },
          "A9": {
            "value": "J (KPI Quality 1-5): 5=all quantitative multi-yr, 4=mostly quantitative, 3=mixed, 2=mostly subjective, 1=fully subjective",
            "readOnly": true
          },
          "A10": {
            "value": "M (ESOP Structure 1-5): 5=FMV+perf conditions, 4=FMV+partial perf, 3=below FMV mixed, 2=below FMV time-only, 1=face-value",
            "readOnly": true
          },
          "A11": {
            "value": "Task 3: Computed Fields",
            "readOnly": true,
            "bold": true
          },
          "A12": {
            "value": "U (Alignment Gap): =S-T (Comp CAGR minus PAT CAGR)",
            "readOnly": true
          },
          "A13": {
            "value": "V (Composite Score): =(D/10)*(I/20)*(J/5)*(M/5) scaled appropriately",
            "readOnly": true
          },
          "A14": {
            "value": "W (Governance Flag): RED if V<2 or D>10, AMBER if V 2-3, GREEN if V>3 and D<=10",
            "readOnly": true
          }
        }
      }
    ]
