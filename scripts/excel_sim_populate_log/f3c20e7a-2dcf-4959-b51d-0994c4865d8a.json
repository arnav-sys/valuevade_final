          "A1": {
            "value": "Setup Best Practices for Analyst Workspace",
            "readOnly": true,
            "bold": true
          },
          "A2": {
            "value": "1. Use descriptive headers with units (₹ Cr, %, INR)",
            "readOnly": true
          },
          "A3": {
            "value": "2. Keep data and calculations on separate sheets",
            "readOnly": true
          },
          "A4": {
            "value": "3. Use Data sheet for raw information (read-only when shared)",
            "readOnly": true
          },
          "A5": {
            "value": "4. Use Analysis/Answers sheet for formulas and outputs",
            "readOnly": true
          },
          "A6": {
            "value": "5. Freeze top row to keep headers visible while scrolling",
            "readOnly": true
          },
          "A7": {
            "value": "6. Use named ranges for frequently referenced data blocks",
            "readOnly": true
          },
          "A8": {
            "value": "7. Apply number formatting (₹ symbol, decimal places) consistently",
            "readOnly": true
          },
          "A9": {
            "value": "8. Add totals and subtotals row below data for quick validation",
            "readOnly": true
          },
          "A10": {
            "value": "9. Use color-coding for sector or risk categories",
            "readOnly": true
          },
          "A11": {
            "value": "10. Document assumptions and data sources in a Notes sheet",
            "readOnly": true
          }
